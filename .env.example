# Base URL of NestJS API (Celery worker posts resume analysis here)
DRF_BASE_URL=http://localhost:3003

# Must match interviewsta-backend INTERNAL_API_KEY exactly (header X-Internal-API-Key)
DRF_INTERNAL_API_KEY=change-me-in-production

# Redis, DB, LLM keys, etc. — copy from your local .env as needed.

# Sarvam AI (STT/TTS) — used when JWT allows and client sends payload.use_sarvam_audio
# SARVAM_API_SUBSCRIPTION_KEY=
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_LANGUAGE_CODE=en-IN
# SARVAM_STT_SAMPLE_RATE=16000
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_TARGET_LANGUAGE_CODE=en-IN
# SARVAM_TTS_SAMPLE_RATE=22050
# SARVAM_TTS_PACE=1.1
