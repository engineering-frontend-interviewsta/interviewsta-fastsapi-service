# CommByAI FastAPI service

# Shared JWT secret — must match comm-by-ai/backend JWT_SECRET exactly
JWT_SECRET=your-jwt-secret-change-in-production
JWT_SIGNING_KEY=your-jwt-secret-change-in-production

# Redis (used for caching/sessions)
REDIS_URL=redis://localhost:6379

# OpenAI (LLM for activity generation, evaluation, scenarios)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cartesia (STT)
CARTESIA_API_KEY=
CARTESIA_MODEL=ink-whisper
CARTESIA_API_VERSION=2025-04-16

# AWS Polly (TTS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_POLLY_VOICE_ID=Joanna
AWS_POLLY_ENGINE=neural
AWS_POLLY_SPEECH_RATE=85%

# Tavily (optional web search)
TAVILY_API_KEY=

# CORS (comma-separated; defaults baked in)
# CORS_ORIGINS=http://localhost:5174

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true